# OpenCart Docker Environment Variables
# Copy to .env and configure

# ===========================================
# Database Configuration
# ===========================================
DB_ROOT_PASSWORD=SecureRootPass2026
DB_DATABASE=opencart
DB_USERNAME=opencart
DB_PASSWORD=SecureDbPass2026
DB_PREFIX=oc_

# ===========================================
# OpenCart Configuration
# ===========================================
# Your domain URL (with https://, without trailing slash)
OPENCART_URL=https://your-domain.com

# Admin credentials (auto-created on first deploy)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourSecureAdminPass123
ADMIN_EMAIL=admin@your-domain.com

# ===========================================
# Performance Settings
# ===========================================
# ionCube and Xdebug are disabled by default to enable JIT (faster)
# They are incompatible with JIT - enabling either will disable JIT

# Set to 1 only if you need ionCube-encoded modules
IONCUBE_ENABLED=0

# Set to 1 only for local development with VS Code debugging
XDEBUG_ENABLED=0

# ===========================================
# IMPORTANT NOTES
# ===========================================
# 1. Do NOT use special characters in passwords: $ # ! @ ` \
#    These get interpreted by shell and cause issues
#
# 2. For Coolify: add these in Environment Variables section
#
# 3. After deploy, login at: https://your-domain.com/admin
#    with ADMIN_USERNAME and ADMIN_PASSWORD from above
#
# 4. JIT, ionCube, and Xdebug are mutually exclusive:
#    - JIT enabled (default) = maximum performance
#    - ionCube enabled = for encoded PHP modules (disables JIT)
#    - Xdebug enabled = for debugging in VS Code (disables JIT)
