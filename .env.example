# =============================================
# OpenCart (OcStore) Docker - Змінні середовища
# =============================================
# Скопіюйте цей файл як .env та налаштуйте
# Для Coolify: додайте ці змінні в розділі Environment Variables
#
# УВАГА: НЕ використовуйте спецсимволи в паролях: $ # ! @ ` \
# Вони інтерпретуються shell і спричиняють помилки

# =============================================
# База даних (обов'язкові)
# =============================================

# Пароль root користувача MariaDB
DB_ROOT_PASSWORD=SecureRootPass2024

# Назва бази даних
DB_DATABASE=opencart

# Користувач бази даних (НЕ root)
DB_USERNAME=opencart

# Пароль користувача бази даних
DB_PASSWORD=SecureDbPass2024

# Префікс таблиць OpenCart (за замовчуванням oc_)
DB_PREFIX=oc_

# =============================================
# OpenCart (обов'язкові)
# =============================================

# URL вашого сайту (з https://, БЕЗ слешу в кінці)
# Приклади:
#   - Coolify: https://shop.example.com
#   - Локально: http://localhost:8080
OPENCART_URL=https://your-domain.com

# =============================================
# Адміністратор (створюється при першому деплої)
# =============================================

# Логін адміністратора
ADMIN_USERNAME=admin

# Пароль адміністратора (мін. 8 символів)
ADMIN_PASSWORD=YourSecureAdminPass123

# Email адміністратора
ADMIN_EMAIL=admin@your-domain.com

# =============================================
# Продуктивність (опціонально)
# =============================================
# JIT, ionCube та Xdebug несумісні між собою.
# За замовчуванням увімкнено JIT для максимальної швидкості.

# ionCube Loader - для закодованих PHP модулів
# 0 = вимкнено (JIT працює) - рекомендовано
# 1 = увімкнено (JIT вимикається)
IONCUBE_ENABLED=0

# Xdebug - для налагодження в VS Code/PhpStorm
# 0 = вимкнено (JIT працює) - для продакшену
# 1 = увімкнено (JIT вимикається) - для розробки
XDEBUG_ENABLED=0

# =============================================
# Після деплою
# =============================================
# Адмінка:      https://your-domain.com/admin
# phpMyAdmin:   https://pma.your-domain.com (або порт 8081 локально)
# FileBrowser:  https://files.your-domain.com (або порт 8082 локально)
#
# FileBrowser вхід за замовчуванням: admin / admin
# (змініть пароль після першого входу!)

# =============================================
# Coolify: налаштування доменів
# =============================================
# В Coolify UI для кожного сервісу вкажіть домен:
#   - opencart:    shop.example.com
#   - phpmyadmin:  pma.example.com
#   - filebrowser: files.example.com
#
# Coolify автоматично налаштує SSL сертифікати
