# OpenCart Docker Environment Variables
# Copy this file to .env and configure for your environment

# ===========================================
# Database Configuration
# ===========================================
DB_ROOT_PASSWORD=your_secure_root_password_here
DB_DATABASE=opencart
DB_USERNAME=opencart
DB_PASSWORD=your_secure_db_password_here
DB_PREFIX=oc_

# ===========================================
# OpenCart Configuration
# ===========================================
# Your domain URL (without trailing slash)
OPENCART_URL=https://your-domain.com

# Admin email for notifications
ADMIN_EMAIL=admin@your-domain.com

# ===========================================
# Coolify Notes
# ===========================================
# When deploying via Coolify:
# 1. Add these variables in Coolify's Environment Variables section
# 2. Coolify will automatically handle SSL/HTTPS via Traefik
# 3. Set your domain in Coolify's Domain settings
# 4. phpMyAdmin will be available on a separate subdomain (configure in Coolify)

# ===========================================
# Security Reminders
# ===========================================
# - Change all default passwords
# - Use strong, unique passwords (min 16 characters)
# - Never commit .env file to version control
# - Restrict phpMyAdmin access in production
