# MariaDB Configuration for OpenCart 3 (OcStore)
# Optimized for e-commerce workloads

[mysqld]
# --------------------------------------------
# Basic Settings
# --------------------------------------------
user = mysql
datadir = /var/lib/mysql
socket = /run/mysqld/mysqld.sock
port = 3306
bind-address = 0.0.0.0

# Character Set
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
character-set-client-handshake = FALSE

# Skip reverse DNS lookup
skip-name-resolve
skip-host-cache

# --------------------------------------------
# InnoDB Settings (Primary Storage Engine)
# --------------------------------------------
default-storage-engine = InnoDB

# Buffer pool - adjust based on available RAM
# For 2GB RAM server: 1G, For 4GB: 2G, For 8GB: 4-5G
innodb_buffer_pool_size = 1G
innodb_buffer_pool_instances = 4

# Transaction logs
innodb_log_file_size = 256M
innodb_log_buffer_size = 16M
innodb_log_files_in_group = 2

# I/O settings
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
innodb_doublewrite = 1

# Concurrency
innodb_thread_concurrency = 0
innodb_read_io_threads = 4
innodb_write_io_threads = 4

# File per table (recommended)
innodb_file_per_table = 1

# Stats
innodb_stats_on_metadata = 0

# Lock wait timeout
innodb_lock_wait_timeout = 50

# --------------------------------------------
# Query Cache (MariaDB specific)
# --------------------------------------------
query_cache_type = 1
query_cache_size = 64M
query_cache_limit = 2M
query_cache_min_res_unit = 2K

# --------------------------------------------
# Connection Settings
# --------------------------------------------
max_connections = 150
max_connect_errors = 100
wait_timeout = 600
interactive_timeout = 600
max_allowed_packet = 64M

# Thread cache
thread_cache_size = 50
thread_stack = 256K

# --------------------------------------------
# Temporary Tables
# --------------------------------------------
tmp_table_size = 64M
max_heap_table_size = 64M

# --------------------------------------------
# Buffer Settings
# --------------------------------------------
read_buffer_size = 1M
read_rnd_buffer_size = 4M
join_buffer_size = 4M
sort_buffer_size = 4M
bulk_insert_buffer_size = 16M

# --------------------------------------------
# Table Cache
# --------------------------------------------
table_open_cache = 4000
table_definition_cache = 2000
open_files_limit = 65535

# --------------------------------------------
# Logging
# --------------------------------------------
# Slow query log (enable for debugging)
slow_query_log = 0
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 2

# Error log
log_error = /var/lib/mysql/error.log
log_warnings = 2

# Binary log (disable if not using replication)
skip-log-bin

# --------------------------------------------
# Performance Schema (disable for small servers)
# --------------------------------------------
performance_schema = OFF

# --------------------------------------------
# Security
# --------------------------------------------
local_infile = 0
symbolic-links = 0

# Disable SSL requirement (for internal Docker network)
skip-ssl

[client]
default-character-set = utf8mb4
socket = /run/mysqld/mysqld.sock

[mysql]
default-character-set = utf8mb4

[mysqldump]
quick
quote-names
max_allowed_packet = 64M
