# MariaDB 10.6 — Optimized for OpenCart 3
# Target: 8GB RAM VM (Coolify Docker)
# Last updated: 2026-03-25

[mysqld]

# ==========================================
# Basic Settings
# ==========================================
user                        = mysql
datadir                     = /var/lib/mysql
socket                      = /run/mysqld/mysqld.sock
port                        = 3306
bind-address                = 0.0.0.0

skip-name-resolve
skip-host-cache
skip-ssl

# ==========================================
# Character Set
# ==========================================
character-set-server        = utf8mb4
collation-server            = utf8mb4_unicode_ci
character-set-client-handshake = FALSE

# ==========================================
# Storage Engine
# ==========================================
default-storage-engine      = InnoDB
innodb_file_per_table       = 1
innodb_stats_on_metadata    = 0
innodb_lock_wait_timeout    = 50

# ==========================================
# InnoDB Memory (VM: 8GB, container: ~5.7GB)
# Buffer pool = ~35% of available RAM
# ==========================================
innodb_buffer_pool_size     = 2G
innodb_buffer_pool_instances = 2
innodb_log_file_size        = 256M
innodb_log_buffer_size      = 64M
innodb_log_files_in_group   = 2

# ==========================================
# InnoDB I/O Performance
# ==========================================
# 2 = flush log every second (faster than 1=per-commit, safer than 0)
innodb_flush_log_at_trx_commit = 2
innodb_flush_method         = O_DIRECT
innodb_doublewrite          = 1
innodb_io_capacity          = 400
innodb_io_capacity_max      = 800
innodb_read_io_threads      = 4
innodb_write_io_threads     = 4
innodb_thread_concurrency   = 0

# ==========================================
# Query Cache — DISABLED (deprecated in 10.6, causes locking)
# ==========================================
query_cache_type            = 0
query_cache_size            = 0

# ==========================================
# Connection Settings
# ==========================================
max_connections             = 100
max_connect_errors          = 200
max_allowed_packet          = 64M
wait_timeout                = 300
interactive_timeout         = 300
thread_cache_size           = 32
thread_stack                = 256K

# ==========================================
# Temp Tables (for complex JOINs / OpenCart filters)
# ==========================================
tmp_table_size              = 64M
max_heap_table_size         = 64M

# ==========================================
# Buffer Settings
# ==========================================
read_buffer_size            = 512K
read_rnd_buffer_size        = 2M
join_buffer_size            = 2M
sort_buffer_size            = 2M
bulk_insert_buffer_size     = 8M

# ==========================================
# Table Cache
# ==========================================
table_open_cache            = 2000
table_definition_cache      = 1000
open_files_limit            = 65535

# ==========================================
# Slow Query Log (ON — threshold: 2s)
# ==========================================
slow_query_log              = 1
slow_query_log_file         = /var/lib/mysql/slow.log
long_query_time             = 2
log_queries_not_using_indexes = 0

# Error log
log_error                   = /var/lib/mysql/error.log
log_warnings                = 2

# No binary log (not using replication)
skip-log-bin

# ==========================================
# Security
# ==========================================
local_infile                = 0
symbolic-links              = 0

# ==========================================
# Performance Schema (disable — saves ~400MB RAM)
# ==========================================
performance_schema          = OFF

[client]
default-character-set       = utf8mb4
socket                      = /run/mysqld/mysqld.sock

[mysql]
default-character-set       = utf8mb4

[mysqldump]
quick
quote-names
max_allowed_packet          = 64M
